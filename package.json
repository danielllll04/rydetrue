{
  "name": "rydetrue",
  "version": "0.1.0",
  "private": true,
  "description": "Evidence-led dispute resolution platform for Ryde (Multi-Agent Autonomous Dispute Resolution System, Tencent Cloud AI CAN DO IT Hackathon Singapore 2026)",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src --ext .ts,.tsx --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:push": "prisma db push --skip-generate",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "rm -f prisma/dev.db && npm run db:push && npm run db:seed",
    "typecheck": "tsc --noEmit",
    "test:frontend": "tsx --test src/frontend/lib/*.test.ts",
    "dev:demo": "node scripts/demo-server.mjs dev",
    "start:demo": "node scripts/demo-server.mjs start",
    "dev:groq": "node scripts/groq-server.mjs dev",
    "start:groq": "node scripts/groq-server.mjs start",
    "verify:groq": "node --import tsx scripts/verify-groq.mjs",
    "start:two-category:mock": "node scripts/two-category-server.mjs mock start",
    "start:two-category:groq": "node scripts/two-category-server.mjs groq start",
    "verify:two-categories": "node --import tsx scripts/verify-two-categories.mjs",
    "start:public": "node scripts/public-server.mjs",
    "verify:public": "node --import tsx scripts/verify-public.mjs"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "lucide-react": "^0.468.0",
    "next": "15.5.28",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^8.57.1",
    "postcss": "8.5.30",
    "prettier": "^3.9.10",
    "prisma": "^5.22.0",
    "tailwindcss": "4.3.3",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "4.1.11",
    "vite": "7.3.7",
    "@tailwindcss/postcss": "4.3.3",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0"
  },
  "overrides": {
    "postcss": "8.5.30"
  },
  "engines": {
    "node": ">=22.14.0 <23"
  }
}
